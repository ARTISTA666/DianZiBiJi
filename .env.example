COMPOSE_PROJECT_NAME=eln
APP_ENV=development

POSTGRES_DB=eln
POSTGRES_USER=eln_user
POSTGRES_PASSWORD=eln_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

BACKEND_PORT=8001
FRONTEND_PORT=3000
SYSTEM_STORAGE_PATH=./storage
# In-container backend path. Tests and non-container runs may override it.
STORAGE_ROOT=/storage

SECRET_KEY=change-me-in-production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
LOGIN_FAILURE_DELAY_BASE_MS=100
LOGIN_FAILURE_DELAY_MAX_MS=2000
LOGIN_MAX_CONCURRENT_ATTEMPTS=4
# Per-client request ceilings. They tolerate normal page hydration and a small
# research group sharing one NAT address while still rejecting sustained abuse.
GLOBAL_RATE_LIMIT_READ_PER_MINUTE=600
GLOBAL_RATE_LIMIT_WRITE_PER_MINUTE=120
# Only these direct peer addresses may supply X-Forwarded-For/X-Real-IP.
# Keep this in sync with the reverse proxy network; leave empty for direct-only mode.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Python/FastAPI IP-based login rate limit (separate from Rust per-username limiter)
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=60
# Development accesses the backend directly. Production must use /api through
# the same-origin TLS reverse proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Unified OpenAI-compatible provider configuration. AI_* takes precedence;
# DEEPSEEK_* remains a migration fallback for existing deployments.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_CONCURRENCY=4
# Enable the server-side Agent only for the intended canary environment/users.
NEW_AGENT_ENABLED=false
NEXT_PUBLIC_NEW_AGENT_ENABLED=false
# Sensitive project content is blocked from external AI by default. Enable
# only after an explicit data-governance decision and vendor review.
ALLOW_SENSITIVE_EXTERNAL_AI=false

# Hash embeddings are a deterministic test backend and are rejected outside
# development/test. Production uses one OpenAI-compatible BGE-M3 endpoint.
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=rust-hash-512-v1
EMBEDDING_DIMENSION=512
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
DOCUMENT_TEXT_MAX_CHARS=2000000
UPLOAD_MAX_BYTES=52428800
OCR_LANGUAGES=chi_sim+eng
OCR_PREPROCESSING=grayscale_otsu
OCR_PAGE_SEGMENTATION_MODE=3
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_RETRIEVAL_TOP_K=6
RAG_COLLECTION_RETRIEVAL_TOP_K=12
RAG_VECTOR_CANDIDATE_K=30
RAG_GRAPH_TOP_K=10
RAG_GRAPH_MIN_SCORE=1.0
# 检索结果相关度下限（有限且不小于 0）；低于该分数的候选不进入生成上下文，设为 0 沿用旧的仅过滤零分行为
RAG_MIN_RETRIEVAL_SCORE=0.15
# rrf-v1 is the new default; legacy-weighted is the explicit rollback path.
RAG_RETRIEVAL_STRATEGY=rrf-v1
# Changing this version marks prior sync records stale and requires explicit rebuild.
RAG_INDEX_VERSION=structured-v1

# 测试库宿主端口（docker-compose.test-db.yml 默认；scripts/run-rust-db-tests.sh 会动态发现实际端口）
TEST_DB_PORT=55432
