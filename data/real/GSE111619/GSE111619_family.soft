^SAMPLE = GSM3035185
!Sample_title = H226 shControl, 6 days doxycycline, replicate 1
!Sample_geo_accession = GSM3035185
!Sample_status = Public on Aug 27 2018
!Sample_submission_date = Mar 09 2018
!Sample_last_update_date = Aug 27 2018
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = H226 shControl_6 days doxycycline
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = cell line: H226
!Sample_characteristics_ch1 = cell type: lung squamous cell carcinoma
!Sample_characteristics_ch1 = inducible shrna construct: Control
!Sample_characteristics_ch1 = treatment: 1 µg/mL doxycycline
!Sample_characteristics_ch1 = culture condition: 37°C, 5% CO2, 6 days
!Sample_treatment_protocol_ch1 = 6 days 1 µg/mL doxycycline
!Sample_growth_protocol_ch1 = All cell lines were plated 24 hours prior to treatment and incubated at 37°C in a humidified atmosphere with 5% CO2
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = RNA was extracted using a PureLink RNA Mini kit , according to manufacturer's instructions. Total RNA quality was assessed using Bioanalyzer RNA Pico chips (Agilent) and all samples had RIN >9.
!Sample_extract_protocol_ch1 = Libraries for Illumina sequencing were prepared using a TruSeq Stranded mRNA Library Prep Kit (Illumina), according to the manufacturer’s instructions.
!Sample_description = total RNA from doxycycline-treated H226 shControl cells
!Sample_description = shControl_rep1
!Sample_description = NonTargeting_rep1
!Sample_data_processing = Signal processing, base-calling, and quality scoring was carried out automatically by the HiSeq 2500 Real-Time Analysis (RTA) software (Illumina)
!Sample_data_processing = Demultiplexing and conversion to FASTQ format was carried out using bcl2fastq (v1.8.4, Illumina)
!Sample_data_processing = FASTQC (v0.11.2) was used to assess sequence data quality
!Sample_data_processing = Low quality bases (Q <10) were trimmed from the 3' end of reads and short reads (<30 nt after trimming) and adaptor sequences were removed using the fastqc-mcf tool from ea-utils
!Sample_data_processing = FastQ Screen (v0.11.0) was used to check for common sequencing contaminants
!Sample_data_processing = Alignment to the Human reference genome (GRCh37/hg19) was carried out using TopHat2 (v2.0.13, --b2-sensitive --keep-fasta-order --no-coverage-search --max-multihits 10 --library-type fr-firststrand) with the UCSC hg19 GTF annotation file provided in the iGenomes UCSC hg19 bundle (https://support.illumina.com/sequencing/sequencing_software/igenome.html)
!Sample_data_processing = Aligned reads were then filtered to remove low quality mapped reads (MAPQ < 10) using SAMtools (v0.1.19)
!Sample_data_processing = Reads were coordinate sorted and duplicates were marked using Picard (v1.129)
!Sample_data_processing = Quality assessment of final mapped reads was performed using RSeQC (v2.6)
!Sample_data_processing = Raw gene-level count data was generated using HTSeq (v0.6.1) with the following options (--stranded=reverse –minaqual=10 –type=exon –idattr=gene --mode=intersection-nonempty) using the GTF provided in the UCSC hg19-based igenomes bundle (https://support.illumina.com/sequencing/sequencing_software/igenome.html)
!Sample_data_processing = Genome_build: GRCh37/hg19; Bowtie2 index and GTF from iGenomes UCSC hg19 bundle (https://support.illumina.com/sequencing/sequencing_software/igenome.html)
!Sample_data_processing = Supplementary_files_format_and_content: Tab delimited text files containing raw gene-level counts for each sample
!Sample_platform_id = GPL16791
!Sample_contact_name = Matthew,D,Galbraith
!Sample_contact_department = Department of Pharmacology; Linda Crnic Institute for Down Syndrome
!Sample_contact_institute = University of Colorado Anschutz Medical Campus
!Sample_contact_address = 12800 E. 19th Ave.
!Sample_contact_city = Aurora
!Sample_contact_state = CO
!Sample_contact_zip/postal_code = 80045
!Sample_contact_country = USA
