^DATABASE = GeoMiame
!Database_name = Gene Expression Omnibus (GEO)
!Database_institute = NCBI NLM NIH
!Database_web_link = http://www.ncbi.nlm.nih.gov/geo
!Database_email = geo@ncbi.nlm.nih.gov
^SERIES = GSE111619
!Series_title = Poly(A)+ RNA-seq from H226 cells expressing doxycycline-inducible Control (non-targeting) and p63-targeting shRNAs
!Series_geo_accession = GSE111619
!Series_status = Public on Aug 27 2018
!Series_submission_date = Mar 09 2018
!Series_last_update_date = Mar 27 2019
!Series_pubmed_id = 30232004
!Series_summary = To determine the impact of ΔNp63α knockdown on steady-state mRNA levels, we performed poly(A)-enriched RNA-seq analysis of lung squamous cell carcinoma line H226 (inducible shControl and shp63) in the presence of 1µg/mL doxycycline to induce shRNA expression.
!Series_overall_design = Poly(A)+ RNA for two independent biological replicates was purified  from H226 cells (inducible shControl and shp63) incubated treated for six days with 1 µg/mL doxycycline. a TruSeq Stranded mRNA Library Prep Kit (Illumina). Libraries were sequenced on an Illumina HiSeq 2000 system at the University of Colorado Cancer Center Genomics and Microarray Core facility. Reads were aligned (TopHat2) to the Human reference genome (GRCh37/hg19) and gene-level counts (HTseq-count) were used for differential expression analysis (DESeq2).
!Series_type = Expression profiling by high throughput sequencing
!Series_contributor = Christopher,G,Abraham
!Series_contributor = Ahwan,,Pandey
!Series_contributor = Matthew,D,Galbraith
!Series_contributor = Joaquin,M,Espinosa
!Series_sample_id = GSM3035185
!Series_sample_id = GSM3035186
!Series_sample_id = GSM3035187
!Series_sample_id = GSM3035188
!Series_contact_name = Matthew,D,Galbraith
!Series_contact_department = Department of Pharmacology; Linda Crnic Institute for Down Syndrome
!Series_contact_institute = University of Colorado Anschutz Medical Campus
!Series_contact_address = 12800 E. 19th Ave.
!Series_contact_city = Aurora
!Series_contact_state = CO
!Series_contact_zip/postal_code = 80045
!Series_contact_country = USA
!Series_supplementary_file = ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE111nnn/GSE111619/suppl/GSE111619_RNAseq_H226_shp63_analysis_HTSeq_counts.txt.gz
!Series_platform_id = GPL16791
!Series_platform_taxid = 9606
!Series_sample_taxid = 9606
!Series_relation = SubSeries of: GSE111635
!Series_relation = BioProject: https://www.ncbi.nlm.nih.gov/bioproject/PRJNA437576
!Series_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRP134235
^PLATFORM = GPL16791
