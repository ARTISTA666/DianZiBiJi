  "recommended_minimal_change": {
    "approved_by_review": true,
    "change": "Only change the post-ready interrupted wait from 10 to 40 seconds and explain the 30-second Rust lease plus 1-second reaper in a comment. Preserve pre-kill running wait 10, resume wait 30, pure_llm payload, unexecuted_cases==1, status==completed and completed_cases==1 assertions.",
    "reason": "40 seconds accommodates the measured 29.909-second ready-to-final interval and lease/reaper contract without weakening the success criteria or reclaiming a valid worker lease. Host suspension or long HTTP calls can still exceed the bound.",
    "product_or_stub_change_needed": false,
    "root_proposed_current_probe_sha256": "34a11cbd1d804e7e4594592d8a94346aacdce3bc5c5fefef5ba7f619c7223638",
    "root_proposed_delta": [
      "--- v7_executed_probe",
      "+++ root_proposed_primary_probe",
      "@@ -98,7 +98,9 @@",
      "         subprocess.run([*compose, \"kill\", \"-s\", \"SIGKILL\", \"backend\"], check=True, capture_output=True, text=True)",
      "         subprocess.run([*compose, \"up\", \"-d\", \"--no-deps\", \"backend\"], check=True, capture_output=True, text=True)",
      "         wait_for_ready(client)",
      "-        interrupted = wait_for_status(client, run_id, {\"interrupted\"}, 10)",
      "+        # Rust preserves the worker's 30-second lease across a fast restart;",
      "+        # allow lease expiry and the one-second reaper before expecting interruption.",
      "+        interrupted = wait_for_status(client, run_id, {\"interrupted\"}, 40)",
      "         if interrupted[\"summary_json\"].get(\"unexecuted_cases\") != 1:",
      "             raise RuntimeError(\"Interrupted run did not retain its unexecuted case\")",
      " "
    ]
