\ProvidesPackage{ahnu-reference}[2026/09/13 AHNU reference thesis overlay]
% Load after the unchanged bensz-thesis AHNU profile. Measurements are PDF bp.
\RequirePackage{needspace}
\RequirePackage{adjustbox}
\geometry{a4paper,left=2.8cm,right=2.8cm,top=2.8cm,bottom=2.8cm,
  headheight=14bp,headsep=23.6bp,footskip=26.8bp}
\IfFontExistsTF{SimSun}{
  \setCJKmainfont{SimSun}[AutoFakeBold=2]
  \setCJKfamilyfont{ahnuReplicaSong}[AutoFakeBold=2]{SimSun}
  \renewcommand{\ahnuSong}{\CJKfamily{ahnuReplicaSong}}
}{\IfFontExistsTF{Songti SC}{
  \setCJKfamilyfont{ahnuReplicaSong}[AutoFakeBold=1.2]{Songti SC}
  \renewcommand{\ahnuSong}{\CJKfamily{ahnuReplicaSong}}}{}
  \typeout{AHNU-FONT-FALLBACK: SimSun unavailable; using Songti SC or FandolSong}}
\IfFontExistsTF{SimHei}{\setCJKfamilyfont{ahnuReplicaHei}{SimHei}
  \renewcommand{\ahnuHei}{\CJKfamily{ahnuReplicaHei}}}{
  \typeout{AHNU-FONT-FALLBACK: SimHei unavailable; using Heiti SC or FandolHei}}
\renewcommand{\ahnuHeaderFont}{\normalfont\fontsize{9bp}{11bp}\selectfont}
\renewcommand{\ahnuFrontTitleFont}{\ahnuSong\bfseries\fontsize{18bp}{24bp}\selectfont}
\renewcommand{\ahnuSubsectionFont}{\ahnuHei\bfseries\fontsize{14bp}{20bp}\selectfont}
\ctexset{
  chapter={aftername=\hspace{0.5em},beforeskip=0bp,afterskip=28bp},
  section={beforeskip=18bp,afterskip=24.5bp},
  subsection={beforeskip=12bp,afterskip=14bp}}
\setlength{\parindent}{24bp}
\setlength{\parskip}{0pt}
\setlength{\topskip}{16bp}
\AtBeginDocument{\titlespacing*{\section}{0bp}{18bp}{18.5bp}}
\setlength{\emergencystretch}{4em}
\raggedbottom
% The sample has a 0.7 bp rule and no running header text.
\fancypagestyle{ahnu-main}{\fancyhf{}\fancyfoot[C]{\ahnuHeaderFont\thepage}
  \renewcommand{\headrulewidth}{0.7bp}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{ahnu-front}{\fancyhf{}\fancyfoot[C]{\ahnuHeaderFont\thepage}
  \renewcommand{\headrulewidth}{0.7bp}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\ahnuHeaderFont\thepage}
  \renewcommand{\headrulewidth}{0.7bp}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{ahnu-cover}{\fancyhf{}\fancyfoot[C]{\ahnuHeaderFont\thepage}
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\renewcommand{\ahnuFrontHeading}[1]{%
  \thispagestyle{ahnu-front}\par
  \vspace*{-18bp}{\centering\ahnuFrontTitleFont #1\par}\vspace{5bp}\ahnuBodyFont}

% The reference TOC shows chapters and sections, 14 bp type / 18 bp baseline.
\setcounter{tocdepth}{1}
\contentsmargin{28bp}
\titlecontents{chapter}[5.7em]{\ahnuSong\fontsize{14bp}{18bp}\selectfont}
  {\contentslabel{4.1em}}{\hspace*{-4.1em}}
  {\titlerule*[3bp]{.}\contentspage}
\titlecontents{section}[4.1em]{\ahnuSong\fontsize{14bp}{18bp}\selectfont}
  {\contentslabel{2.05em}}{\hspace*{-2.05em}}
  {\titlerule*[3bp]{.}\contentspage}
\makeatletter
\renewcommand{\tableofcontents}{%
  \clearpage\thispagestyle{empty}
  \vspace*{0bp}{\centering\ahnuHei\fontsize{16bp}{22bp}\selectfont 目\quad 录\par}
  \vspace{24.3bp}\begingroup\advance\linewidth-10.5bp\advance\hsize-10.5bp
  \pagestyle{empty}\@starttoc{toc}\clearpage\endgroup}
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother
\DeclareCaptionFont{ahnufive}{\ahnuSong\fontsize{10.5bp}{15bp}\selectfont}
\captionsetup{font={ahnufive,bf},labelfont=bf,textfont=bf,skip=6bp}
\AtBeginEnvironment{longtable}{\fontsize{10.5bp}{15bp}\selectfont}
\renewcommand{\small}{\fontsize{10.5bp}{15bp}\selectfont}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\graphicspath{{assets/}{assets/screenshots/}{assets/innovation-screenshots/}}

% Preserve source bibliography text and numeric IDs; reproduce the sample's
% 12/20 type and hanging entries. A 30 bp indent accommodates 3-digit labels.
\newcommand{\ahnuReferencesHeading}{%
  \clearpage\phantomsection\addcontentsline{toc}{chapter}{参考文献}
  \vspace*{-12bp}\noindent{\ahnuSong\bfseries 参考文献：}\par\vspace{10bp}}
\newenvironment{ahnuReferences}{\ahnuBodyFont\begin{list}{}{
  \setlength{\leftmargin}{30bp}\setlength{\labelwidth}{26bp}
  \setlength{\labelsep}{4bp}\setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}
  \setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}
  \renewcommand{\makelabel}[1]{##1\hfil}}}{\end{list}}

% Cover: same TikZ construction as upstream, with positions/weights measured
% from the supplied 2024 thesis (never copy that author's personal metadata).
